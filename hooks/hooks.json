{
  "hooks": [
    {
      "type": "command",
      "event": "SessionStart",
      "command": "node \"${CLAUDE_PLUGIN_ROOT}/hooks/session-start-detect.mjs\"",
      "timeout": 10000
    },
    {
      "type": "command",
      "event": "UserPromptSubmit",
      "command": "node \"${CLAUDE_PLUGIN_ROOT}/hooks/prompt-skill-inject.mjs\"",
      "timeout": 5000
    }
  ]
}
